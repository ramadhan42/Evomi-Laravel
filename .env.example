APP_NAME=Evomi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Admin dashboard account (created by db:seed in non-production)
EVOMI_ADMIN_NAME="Evomi Admin"
EVOMI_ADMIN_EMAIL=admin@evomi.id
EVOMI_ADMIN_PASSWORD=password

# Kunci untuk memicu tmp_evomi_sync_deploy.php.
# Dibaca langsung dari berkas .env ini, jadi tetap berlaku walau config di-cache.
# Kosong = endpoint deploy mati total (503). Buat kunci acak sendiri, mis:
#   php -r "echo bin2hex(random_bytes(24));"
# Jangan pernah menuliskannya di berkas yang ter-commit - repo ini publik.
EVOMI_SYNC_KEY=

# Frontend origin for CORS / emails (Blade app + optional Next)
FRONTEND_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evomi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Security hardening (aktif di localhost & production)
SECURITY_ENABLED=true
SECURITY_HEADERS=true
SECURITY_BLOCK_PROBES=true
SECURITY_HONEYPOT=true
SECURITY_API_THROTTLE=true
SECURITY_API_THROTTLE_LIMIT=120,1
SECURITY_SOURCE_GUARD=true

# Cloudflare Turnstile — test keys untuk localhost
# Ganti site key ke 3x00000000000000000000FF untuk memaksa challenge interaktif
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP: MAIL_PASSWORD = App Password (bukan password login)
# Google Account → Security → 2-Step Verification → App passwords
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Evomi"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12

# Optional payment seed credentials (runtime uses payment_settings table)
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# XENDIT_MERCHANT_ID=
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=

# Storefront custom cursor (CDN 96px for all sizes)
EVOMI_CURSOR_ENABLED=true
# EVOMI_CURSOR_CDN=https://cdn.cursors-4u.net/previews/normal-9e607e2c-48.webp
# EVOMI_CURSOR_HOTSPOT_X=33
# EVOMI_CURSOR_HOTSPOT_Y=30
