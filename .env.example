APP_NAME=Evomi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Admin dashboard account (created by db:seed in non-production)
EVOMI_ADMIN_NAME="Evomi Admin"
EVOMI_ADMIN_EMAIL=admin@evomi.com
EVOMI_ADMIN_PASSWORD=password123

# Frontend origin for CORS / emails (Blade app + optional Next)
FRONTEND_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evomi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP: MAIL_PASSWORD = App Password (bukan password login)
# Google Account → Security → 2-Step Verification → App passwords
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Evomi"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12

# Optional payment seed credentials (runtime uses payment_settings table)
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# XENDIT_MERCHANT_ID=
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
