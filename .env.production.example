APP_NAME=Evomi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://evomi.shop

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

EVOMI_ADMIN_NAME="Evomi Admin"
EVOMI_ADMIN_EMAIL=admin@evomi.id
EVOMI_ADMIN_PASSWORD=password

# Kunci untuk memicu tmp_evomi_sync_deploy.php.
# Dibaca langsung dari berkas .env ini, jadi tetap berlaku walau config di-cache.
# Kosong = endpoint deploy mati total (503). Buat kunci acak sendiri, mis:
#   php -r "echo bin2hex(random_bytes(24));"
# Jangan pernah menuliskannya di berkas yang ter-commit - repo ini publik.
EVOMI_SYNC_KEY=

FRONTEND_URL=https://evomi.shop

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u160994497_evomi
DB_USERNAME=u160994497_evomi
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.evomi.shop

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Gmail SMTP: MAIL_PASSWORD = App Password (bukan password login)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Evomi"

VITE_APP_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12
